INSERT INTO `enfermedades` VALUES (1,'Sobrepeso','Control de peso','Controlar porciones, reducir premios y ajustar calorías diarias.','media','Condición en la que el perro tiene más peso del recomendado para su tamaño, edad y raza.'),(2,'Obesidad','Control de peso','Usar una dieta de control de peso y consultar al veterinario para calcular calorías.','alta','Acumulación excesiva de grasa corporal que puede afectar la movilidad, respiración y salud general del perro.'),(3,'Diabetes mellitus','Control de peso','Mantener horarios fijos de comida y dieta controlada bajo indicación veterinaria.','alta','Enfermedad metabólica donde el cuerpo no regula correctamente la glucosa en sangre.'),(4,'Desnutrición','Control de peso','Usar alimento completo y balanceado según edad y condición corporal.','alta','Estado causado por falta de nutrientes, calorías, proteínas, vitaminas o minerales necesarios.'),(5,'Pancreatitis','Digestiva','Evitar alimentos altos en grasa y consultar dieta baja en grasa con veterinario.','alta','Inflamación del páncreas que puede provocar dolor abdominal, vómitos, diarrea y pérdida de apetito.'),(6,'Gastritis','Digestiva','Evitar cambios repentinos de comida y alimentos condimentados.','media','Inflamación del estómago que puede causar vómito, náuseas, dolor abdominal o falta de apetito.'),(7,'Colitis','Digestiva','Mantener dieta estable y revisar ingredientes que puedan causar irritación intestinal.','media','Inflamación del colon que puede causar diarrea, molestias intestinales y evacuaciones frecuentes.'),(8,'Diarrea crónica','Digestiva','Identificar ingredientes problemáticos y evitar cambios rápidos de croqueta.','media','Problema digestivo persistente caracterizado por evacuaciones blandas o líquidas durante varios días o de forma recurrente.'),(9,'Estreñimiento','Digestiva','Aumentar hidratación y revisar el aporte de fibra en la dieta.','baja','Dificultad para evacuar que puede estar relacionada con poca fibra, baja hidratación o poca actividad física.'),(10,'Flatulencias excesivas','Digestiva','Revisar ingredientes, cambiar alimento gradualmente y evitar comidas pesadas.','baja','Producción frecuente de gases intestinales, generalmente asociada a intolerancias, cambios de alimento o mala digestión.'),(11,'Alergia alimentaria','Alergias y piel','Usar dieta de eliminación o alimento hipoalergénico bajo supervisión veterinaria.','media','Reacción del sistema inmune ante ciertos ingredientes del alimento, especialmente algunas proteínas.'),(12,'Intolerancia alimentaria','Alergias y piel','Evitar ingredientes que causen vómito, diarrea, gases o malestar.','media','Dificultad para digerir ciertos ingredientes, sin necesariamente involucrar una reacción alérgica.'),(13,'Dermatitis por alergia alimentaria','Alergias y piel','Revisar si la comezón o irritación coincide con ciertos alimentos.','media','Irritación o inflamación de la piel relacionada con una reacción adversa a ciertos alimentos.'),(14,'Otitis recurrente asociada a alergias','Alergias y piel','Consultar si las infecciones de oído se repiten junto con síntomas de alergia.','media','Infecciones o inflamaciones repetidas del oído que pueden estar relacionadas con alergias alimentarias.');
/*!40000 ALTER TABLE `enfermedades` ENABLE KEYS */;
UNLOCK TABLES;

